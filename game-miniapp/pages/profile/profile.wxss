/* pages/profile/profile.wxss */
/* 科技感个人中心样式 */

.container {
  padding: 30rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

/* 用户卡片 */
.user-card {
  position: relative;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.9) 0%, rgba(15, 22, 50, 0.95) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: -50%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.2) 0%, transparent 70%);
}

.card-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #667eea;
  border-radius: 50%;
  animation: float 3s ease-in-out infinite;
}

.p1 { top: 20%; right: 15%; animation-delay: 0s; }
.p2 { top: 60%; right: 25%; background: #00d4ff; animation-delay: 1s; }
.p3 { top: 40%; right: 10%; background: #f093fb; animation-delay: 2s; }

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-15rpx) scale(1.5); opacity: 1; }
}

.user-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 30rpx;
  z-index: 1;
}

.user-content.guest {
  cursor: pointer;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(102, 126, 234, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border: 2rpx solid transparent;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #00d4ff, #f093fb, #667eea) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  animation: rotate 4s linear infinite;
}

@keyframes rotate {
  to { transform: rotate(360deg); }
}

.online-dot {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 24rpx;
  height: 24rpx;
  background: #00d4ff;
  border-radius: 50%;
  border: 4rpx solid #0d1126;
  box-shadow: 0 0 10rpx #00d4ff;
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.user-id-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-id-label {
  font-size: 22rpx;
  color: rgba(102, 126, 234, 0.8);
  background: rgba(102, 126, 234, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.user-id {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.6);
}

.login-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #667eea;
}

.login-hint .arrow {
  transition: transform 0.3s;
}

.user-content.guest:active .login-hint .arrow {
  transform: translateX(8rpx);
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.8) 0%, rgba(15, 22, 50, 0.9) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  color: transparent;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(224, 230, 255, 0.5);
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.3), transparent);
}

.section-title {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.5);
  letter-spacing: 4rpx;
}

/* 功能菜单网格 */
.menu-section {
  margin-bottom: 30rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.6) 0%, rgba(15, 22, 50, 0.8) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  border-radius: 20rpx;
}

.menu-item:active {
  transform: scale(0.95);
  border-color: rgba(102, 126, 234, 0.4);
}

.menu-icon-wrap {
  margin-bottom: 16rpx;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.menu-text {
  font-size: 24rpx;
  color: rgba(224, 230, 255, 0.7);
}

/* 关于区块 */
.about-section {
  margin-bottom: 30rpx;
}

.about-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.6) 0%, rgba(15, 22, 50, 0.8) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.15);
  border-radius: 20rpx;
}

.about-item:active {
  border-color: rgba(102, 126, 234, 0.4);
}

.about-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.about-icon {
  font-size: 36rpx;
}

.about-text {
  font-size: 30rpx;
  color: rgba(224, 230, 255, 0.8);
}

.about-arrow {
  font-size: 32rpx;
  color: rgba(224, 230, 255, 0.4);
}

/* 退出登录 */
.logout-section {
  margin-bottom: 40rpx;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 107, 157, 0.4);
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #ff6b9d;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(255, 107, 157, 0.1);
}

/* 版本信息 */
.version-info {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.version-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.3), transparent);
}

.version-text {
  font-size: 22rpx;
  color: rgba(102, 126, 234, 0.4);
  letter-spacing: 2rpx;
}
