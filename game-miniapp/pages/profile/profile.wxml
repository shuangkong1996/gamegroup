<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="card-bg"></view>
    <view class="card-particles">
      <view class="particle p1"></view>
      <view class="particle p2"></view>
      <view class="particle p3"></view>
    </view>

    <view class="user-content" wx:if="{{isLoggedIn}}">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar-ring"></view>
        <view class="online-dot"></view>
      </view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '游戏玩家'}}</text>
        <view class="user-id-wrap">
          <text class="user-id-label">ID</text>
          <text class="user-id">{{userInfo.userId}}</text>
        </view>
      </view>
    </view>

    <view class="user-content guest" wx:else bindtap="goLogin">
      <view class="avatar-wrap">
        <view class="avatar-placeholder">
          <text>👤</text>
        </view>
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="nickname">未登录</text>
        <view class="login-hint">
          <text>点击登录开始游戏</text>
          <text class="arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row" wx:if="{{isLoggedIn}}">
    <view class="stat-card">
      <text class="stat-value">0</text>
      <text class="stat-label">游戏场次</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">0</text>
      <text class="stat-label">胜利次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">0%</text>
      <text class="stat-label">胜率</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-title">功能菜单</text>
      <view class="section-line"></view>
    </view>

    <view class="menu-grid">
      <view class="menu-item" data-type="history" bindtap="onMenuTap">
        <view class="menu-icon-wrap">
          <view class="menu-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <text>📋</text>
          </view>
        </view>
        <text class="menu-text">匹配记录</text>
      </view>

      <view class="menu-item" data-type="ledger" bindtap="onMenuTap">
        <view class="menu-icon-wrap">
          <view class="menu-icon" style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);">
            <text>🧾</text>
          </view>
        </view>
        <text class="menu-text">记账台账</text>
      </view>

      <view class="menu-item" data-type="achievements" bindtap="onMenuTap">
        <view class="menu-icon-wrap">
          <view class="menu-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <text>🏆</text>
          </view>
        </view>
        <text class="menu-text">成就徽章</text>
      </view>

      <view class="menu-item" data-type="settings" bindtap="onMenuTap">
        <view class="menu-icon-wrap">
          <view class="menu-icon" style="background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);">
            <text>⚙️</text>
          </view>
        </view>
        <text class="menu-text">设置</text>
      </view>

      <view class="menu-item" data-type="feedback" bindtap="onMenuTap">
        <view class="menu-icon-wrap">
          <view class="menu-icon" style="background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);">
            <text>💬</text>
          </view>
        </view>
        <text class="menu-text">意见反馈</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-section">
    <view class="about-item" data-type="about" bindtap="onMenuTap">
      <view class="about-left">
        <text class="about-icon">ℹ️</text>
        <text class="about-text">关于我们</text>
      </view>
      <text class="about-arrow">→</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view wx:if="{{isLoggedIn}}" class="logout-section">
    <button class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <view class="version-line"></view>
    <text class="version-text">GAME GROUP v1.0.0</text>
    <view class="version-line"></view>
  </view>
</view>
