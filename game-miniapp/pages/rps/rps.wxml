<!--pages/rps/rps.wxml-->
<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-text">正在进入游戏...</view>
  </view>

  <!-- 游戏界面 -->
  <view wx:else class="game-container">
    <!-- 比分区域 -->
    <view class="score-area">
      <view class="score-item">
        <text class="score-label">你</text>
        <text class="score-value">{{session.isPlayer1 ? session.player1Wins : session.player2Wins}}</text>
      </view>
      <view class="score-divider">
        <text class="round-text">第{{session.currentRound}}局</text>
        <text class="vs-text">VS</text>
      </view>
      <view class="score-item">
        <text class="score-label">对手</text>
        <text class="score-value">{{session.isPlayer1 ? session.player2Wins : session.player1Wins}}</text>
      </view>
    </view>

    <!-- 状态提示 -->
    <view class="status-area">
      <text wx:if="{{session.hasChosen && !session.opponentHasChosen}}" class="status-text waiting">
        等待对手出招...
      </text>
      <text wx:elif="{{!session.hasChosen && session.opponentHasChosen}}" class="status-text hurry">
        对手已出招，快出招！
      </text>
      <text wx:elif="{{!session.hasChosen && !session.opponentHasChosen}}" class="status-text">
        请出招
      </text>
    </view>

    <!-- 出招结果展示 -->
    <view wx:if="{{showResult}}" class="result-overlay">
      <view class="result-content">
        <view class="result-choices">
          <view class="result-choice">
            <text class="choice-emoji">
              {{lastRoundResult.myChoice === 'ROCK' ? '✊' : (lastRoundResult.myChoice === 'PAPER' ? '✋' : '✌️')}}
            </text>
            <text class="choice-label">你</text>
          </view>
          <text class="result-vs">VS</text>
          <view class="result-choice">
            <text class="choice-emoji">
              {{lastRoundResult.opponentChoice === 'ROCK' ? '✊' : (lastRoundResult.opponentChoice === 'PAPER' ? '✋' : '✌️')}}
            </text>
            <text class="choice-label">对手</text>
          </view>
        </view>
        <text class="result-text {{lastRoundResult.result === 'WIN' ? 'win' : (lastRoundResult.result === 'LOSE' ? 'lose' : 'draw')}}">
          {{lastRoundResult.result === 'WIN' ? '你赢了！' : (lastRoundResult.result === 'LOSE' ? '你输了' : '平局')}}
        </text>
      </view>
    </view>

    <!-- 选择区域 -->
    <view class="choice-area">
      <view class="choice-btn {{session.hasChosen && session.myChoice === 'ROCK' ? 'selected' : ''}} {{session.hasChosen ? 'disabled' : ''}}"
            bindtap="makeChoice"
            data-choice="ROCK">
        <text class="choice-emoji-large">✊</text>
        <text class="choice-name">石头</text>
      </view>

      <view class="choice-btn {{session.hasChosen && session.myChoice === 'SCISSORS' ? 'selected' : ''}} {{session.hasChosen ? 'disabled' : ''}}"
            bindtap="makeChoice"
            data-choice="SCISSORS">
        <text class="choice-emoji-large">✌️</text>
        <text class="choice-name">剪刀</text>
      </view>

      <view class="choice-btn {{session.hasChosen && session.myChoice === 'PAPER' ? 'selected' : ''}} {{session.hasChosen ? 'disabled' : ''}}"
            bindtap="makeChoice"
            data-choice="PAPER">
        <text class="choice-emoji-large">✋</text>
        <text class="choice-name">布</text>
      </view>
    </view>

    <!-- 已选择提示 -->
    <view wx:if="{{session.hasChosen}}" class="chosen-tip">
      <text>你出了: {{session.myChoice === 'ROCK' ? '石头' : (session.myChoice === 'PAPER' ? '布' : '剪刀')}}</text>
    </view>

    <!-- 规则说明 -->
    <view class="rules-area">
      <text class="rules-text">三局两胜制</text>
    </view>
  </view>
</view>
