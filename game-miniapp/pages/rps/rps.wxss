/* pages/rps/rps.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.loading-text {
  color: #a0a8d0;
  font-size: 32rpx;
}

/* 游戏容器 */
.game-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 比分区域 */
.score-area {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  margin-bottom: 40rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-label {
  color: #a0a8d0;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.score-value {
  color: #667eea;
  font-size: 72rpx;
  font-weight: bold;
}

.score-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.round-text {
  color: #a0a8d0;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.vs-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* 状态区域 */
.status-area {
  margin-bottom: 60rpx;
}

.status-text {
  color: #a0a8d0;
  font-size: 32rpx;
}

.status-text.waiting {
  color: #fbbf24;
}

.status-text.hurry {
  color: #ef4444;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 结果浮层 */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
}

.result-choices {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.result-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.choice-emoji {
  font-size: 80rpx;
}

.choice-label {
  color: #a0a8d0;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.result-vs {
  color: #fff;
  font-size: 36rpx;
  margin: 0 40rpx;
}

.result-text {
  font-size: 48rpx;
  font-weight: bold;
}

.result-text.win {
  color: #22c55e;
}

.result-text.lose {
  color: #ef4444;
}

.result-text.draw {
  color: #fbbf24;
}

/* 选择区域 */
.choice-area {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 40rpx;
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.choice-btn:active {
  transform: scale(0.95);
  background: rgba(102, 126, 234, 0.3);
}

.choice-btn.selected {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.2);
}

.choice-btn.disabled {
  opacity: 0.6;
}

.choice-emoji-large {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.choice-name {
  color: #fff;
  font-size: 28rpx;
}

/* 已选择提示 */
.chosen-tip {
  margin-bottom: 40rpx;
}

.chosen-tip text {
  color: #667eea;
  font-size: 28rpx;
}

/* 规则说明 */
.rules-area {
  margin-top: 40rpx;
}

.rules-text {
  color: #666e99;
  font-size: 24rpx;
}
