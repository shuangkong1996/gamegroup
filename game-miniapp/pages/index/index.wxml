<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部标题区 -->
  <view class="header">
    <view class="header-title">
      <text class="title-main">游戏中心</text>
      <text class="title-sub">GAME CENTER</text>
    </view>
    <view class="header-decoration">
      <view class="dot dot-1"></view>
      <view class="dot dot-2"></view>
      <view class="dot dot-3"></view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-ring">
      <view class="ring-inner"></view>
    </view>
    <text class="loading-text">正在加载游戏...</text>
  </view>

  <!-- 游戏列表 -->
  <view wx:else class="game-list">
    <view wx:if="{{games.length === 0}}" class="empty-state">
      <view class="empty-icon">🎮</view>
      <text class="empty-text">暂无游戏</text>
      <text class="empty-hint">敬请期待更多精彩游戏</text>
    </view>

    <!-- 游戏卡片网格 -->
    <view class="game-grid">
      <view
        wx:for="{{games}}"
        wx:key="id"
        class="game-card"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onGameTap"
      >
        <!-- 卡片光效边框 -->
        <view class="card-border"></view>

        <!-- 卡片内容 -->
        <view class="card-content">
          <!-- 游戏图标 -->
          <view class="game-icon-wrap">
            <image
              class="game-icon"
              src="{{item.icon}}"
              mode="aspectFill"
            ></image>
            <view class="icon-glow"></view>
          </view>

          <!-- 游戏信息 -->
          <view class="game-info">
            <view class="game-name">{{item.name}}</view>
            <view class="game-desc">{{item.description || '精彩游戏等你来战'}}</view>
          </view>

          <!-- 底部信息 -->
          <view class="game-footer">
            <view class="player-info">
              <text class="player-icon">👥</text>
              <text class="player-count">{{item.minPlayers}}-{{item.maxPlayers}}人</text>
            </view>
            <view class="play-btn">
              <text>开始</text>
              <text class="arrow">→</text>
            </view>
          </view>
        </view>

        <!-- 悬浮光点装饰 -->
        <view class="float-dots">
          <view class="float-dot fd-1"></view>
          <view class="float-dot fd-2"></view>
          <view class="float-dot fd-3"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="footer-decoration">
    <view class="line"></view>
    <text class="footer-text">POWERED BY GAMEGROUP</text>
    <view class="line"></view>
  </view>
</view>
