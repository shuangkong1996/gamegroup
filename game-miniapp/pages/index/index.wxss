/* pages/index/index.wxss */
/* 科技感首页样式 */

.container {
  padding: 0;
  padding-bottom: 120rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 40rpx;
  position: relative;
}

.header-title {
  display: flex;
  flex-direction: column;
}

.title-main {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

.title-sub {
  font-size: 24rpx;
  color: rgba(102, 126, 234, 0.8);
  letter-spacing: 8rpx;
  margin-top: 8rpx;
}

.header-decoration {
  position: absolute;
  right: 40rpx;
  top: 70rpx;
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

.dot-1 {
  background: #667eea;
  animation-delay: 0s;
}

.dot-2 {
  background: #00d4ff;
  animation-delay: 0.3s;
}

.dot-3 {
  background: #f093fb;
  animation-delay: 0.6s;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-ring {
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.2);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  position: relative;
}

.ring-inner {
  position: absolute;
  top: 15rpx;
  left: 15rpx;
  right: 15rpx;
  bottom: 15rpx;
  border: 4rpx solid rgba(0, 212, 255, 0.2);
  border-bottom-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite reverse;
}

.loading-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: rgba(224, 230, 255, 0.6);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #e0e6ff;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.5);
}

/* 游戏网格 */
.game-grid {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 游戏卡片 */
.game-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.95) 0%, rgba(15, 22, 50, 0.98) 100%);
}

.card-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.4) 0%, rgba(0, 212, 255, 0.2) 50%, rgba(240, 147, 251, 0.3) 100%) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  pointer-events: none;
}

.card-content {
  padding: 36rpx;
  position: relative;
  z-index: 1;
}

/* 游戏图标 */
.game-icon-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 28rpx;
}

.game-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1e2952 0%, #141c3a 100%);
}

.icon-glow {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  border-radius: 36rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 70%);
  z-index: -1;
}

/* 游戏信息 */
.game-info {
  margin-bottom: 28rpx;
}

.game-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.game-desc {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.6);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部信息 */
.game-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(102, 126, 234, 0.15);
}

.player-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.player-icon {
  font-size: 28rpx;
}

.player-count {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.7);
}

.play-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.4);
}

.arrow {
  font-size: 24rpx;
  transition: transform 0.3s;
}

.game-card:active .play-btn {
  transform: scale(0.95);
}

.game-card:active .arrow {
  transform: translateX(6rpx);
}

/* 悬浮光点 */
.float-dots {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.float-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #667eea;
  border-radius: 50%;
  opacity: 0.6;
  animation: float 3s ease-in-out infinite;
}

.fd-1 {
  top: 20%;
  right: 15%;
  animation-delay: 0s;
}

.fd-2 {
  top: 60%;
  right: 25%;
  background: #00d4ff;
  animation-delay: 1s;
}

.fd-3 {
  top: 40%;
  right: 10%;
  background: #f093fb;
  animation-delay: 2s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.6;
  }
  50% {
    transform: translateY(-20rpx) scale(1.5);
    opacity: 1;
  }
}

/* 底部装饰 */
.footer-decoration {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 60rpx 40rpx;
}

.line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(102, 126, 234, 0.3) 50%, transparent 100%);
}

.footer-text {
  font-size: 20rpx;
  color: rgba(102, 126, 234, 0.5);
  letter-spacing: 4rpx;
}

/* 动画 */
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
