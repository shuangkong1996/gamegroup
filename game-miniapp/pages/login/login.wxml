<!--pages/login/login.wxml-->
<view class="container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="bg-circle c1"></view>
    <view class="bg-circle c2"></view>
    <view class="bg-circle c3"></view>
    <view class="bg-grid"></view>
  </view>

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-wrap">
      <view class="logo-ring"></view>
      <view class="logo-inner">
        <text class="logo-icon">🎮</text>
      </view>
      <view class="logo-glow"></view>
    </view>

    <view class="app-title">
      <text class="title-text">GAME GROUP</text>
      <view class="title-line"></view>
    </view>
    <text class="app-slogan">和好友一起 · 畅玩游戏</text>
  </view>

  <!-- 登录区域 -->
  <view class="login-section">
    <view class="login-card">
      <view class="card-glow-border"></view>

      <view class="login-content">
        <view class="welcome-text">
          <text class="welcome-title">欢迎回来</text>
          <text class="welcome-desc">登录后即可开始匹配游戏</text>
        </view>

        <button
          class="login-btn {{loading ? 'loading' : ''}}"
          bindtap="onLogin"
          disabled="{{loading}}"
        >
          <view class="btn-content">
            <view wx:if="{{loading}}" class="btn-loading">
              <view class="loading-spinner"></view>
              <text>登录中...</text>
            </view>
            <view wx:else class="btn-normal">
              <text class="btn-icon">💫</text>
              <text>微信一键登录</text>
            </view>
          </view>
          <view class="btn-shine"></view>
        </button>

        <view class="agreement">
          <text>登录即表示同意</text>
          <text class="link">《用户协议》</text>
          <text>和</text>
          <text class="link">《隐私政策》</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部装饰 -->
  <view class="bottom-decoration">
    <view class="hex hex-1"></view>
    <view class="hex hex-2"></view>
    <view class="hex hex-3"></view>
  </view>
</view>
