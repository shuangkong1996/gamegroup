/* pages/login/login.wxss */
/* 科技感登录页样式 */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.c1 {
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, #667eea 0%, transparent 70%);
  top: -200rpx;
  right: -200rpx;
}

.c2 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, #00d4ff 0%, transparent 70%);
  bottom: 200rpx;
  left: -150rpx;
}

.c3 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, #f093fb 0%, transparent 70%);
  bottom: -100rpx;
  right: 100rpx;
}

.bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(102, 126, 234, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(102, 126, 234, 0.03) 1px, transparent 1px);
  background-size: 50rpx 50rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
}

.logo-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.logo-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 4rpx solid transparent;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #00d4ff, #f093fb, #667eea) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  animation: rotate 4s linear infinite;
}

.logo-inner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  background: linear-gradient(135deg, rgba(30, 41, 82, 0.9) 0%, rgba(15, 22, 50, 0.95) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 80rpx;
}

.logo-glow {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.3) 0%, transparent 60%);
  animation: pulse 3s ease-in-out infinite;
}

@keyframes rotate {
  to {
    transform: rotate(360deg);
  }
}

.app-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  background: linear-gradient(135deg, #fff 0%, #e0e6ff 50%, #667eea 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.title-line {
  width: 120rpx;
  height: 4rpx;
  margin-top: 16rpx;
  background: linear-gradient(90deg, transparent, #667eea, #00d4ff, #667eea, transparent);
  border-radius: 2rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(224, 230, 255, 0.6);
  letter-spacing: 4rpx;
}

/* 登录区域 */
.login-section {
  position: relative;
  z-index: 1;
}

.login-card {
  position: relative;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.8) 0%, rgba(15, 22, 50, 0.9) 100%);
  border-radius: 32rpx;
  overflow: hidden;
}

.card-glow-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.5) 0%, rgba(0, 212, 255, 0.3) 50%, rgba(240, 147, 251, 0.4) 100%) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  pointer-events: none;
}

.login-content {
  padding: 50rpx 40rpx;
}

.welcome-text {
  text-align: center;
  margin-bottom: 50rpx;
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.6);
}

/* 登录按钮 */
.login-btn {
  position: relative;
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-size: 200% 200%;
  border-radius: 50rpx;
  border: none;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.4);
}

.login-btn::after {
  border: none;
}

.btn-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.btn-normal, .btn-loading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.btn-icon {
  font-size: 36rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.btn-shine {
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transform: skewX(-20deg);
  animation: shine 3s ease-in-out infinite;
}

@keyframes shine {
  0% { left: -100%; }
  50%, 100% { left: 150%; }
}

.login-btn.loading {
  background: linear-gradient(135deg, #4a5a8a 0%, #5a4a7a 100%);
  box-shadow: none;
}

.login-btn.loading .btn-shine {
  display: none;
}

.login-btn:active {
  transform: scale(0.98);
}

/* 协议 */
.agreement {
  text-align: center;
  font-size: 24rpx;
  color: rgba(224, 230, 255, 0.5);
  margin-top: 40rpx;
}

.agreement .link {
  color: #667eea;
}

/* 底部装饰 */
.bottom-decoration {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 30rpx;
}

.hex {
  width: 16rpx;
  height: 16rpx;
  background: rgba(102, 126, 234, 0.4);
  transform: rotate(45deg);
  animation: float 2s ease-in-out infinite;
}

.hex-1 { animation-delay: 0s; }
.hex-2 { animation-delay: 0.3s; background: rgba(0, 212, 255, 0.4); }
.hex-3 { animation-delay: 0.6s; background: rgba(240, 147, 251, 0.4); }

@keyframes float {
  0%, 100% { transform: rotate(45deg) translateY(0); opacity: 0.4; }
  50% { transform: rotate(45deg) translateY(-10rpx); opacity: 1; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.05); }
}
