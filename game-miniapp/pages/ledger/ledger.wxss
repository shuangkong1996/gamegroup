.ledger-page {
  min-height: 100vh;
  background: #0b122e;
  color: #eef2ff;
  padding: 16rpx;
  box-sizing: border-box;
}

.toolbar {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 20rpx;
  padding: 16rpx;
}

.toolbar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar-item {
  flex: 1;
  min-width: 200rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.85);
  margin-bottom: 8rpx;
}

.picker-display {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
}

.toolbar-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(148, 163, 184, 0.20);
  border-radius: 18rpx;
  padding: 14rpx;
}

.stat-title {
  display: block;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.80);
}

.stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.stat.income .stat-value {
  color: #22c55e;
}

.stat.expense .stat-value {
  color: #ef4444;
}

.toolbar-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.mini-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
}

.mini-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}

.loading-wrap,
.empty {
  padding: 32rpx 0;
  text-align: center;
  color: rgba(226, 232, 240, 0.8);
}

.content {
  margin-top: 16rpx;
}

.day-group {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.day-header {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.04);
}

.day-date {
  font-size: 26rpx;
  font-weight: 700;
}

.day-sum {
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.85);
}

.record-item {
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(226, 232, 240, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-remark {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(226, 232, 240, 0.70);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.record-money {
  font-size: 26rpx;
  font-weight: 700;
}

.record-money.income {
  color: #22c55e;
}

.record-money.expense {
  color: #ef4444;
}

.record-del {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
  background: rgba(239, 68, 68, 0.16);
  color: #fecaca;
  border-radius: 12rpx;
  border: none;
}

.load-more {
  width: 100%;
  margin-top: 10rpx;
}

.fab {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  z-index: 10;
}

.fab-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  height: 82rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
}

.modal-wrap {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.modal {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #0b122e;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 18rpx;
  max-height: 78vh;
  overflow: auto;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.form-row {
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  color: #eef2ff;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 14rpx;
  box-sizing: border-box;
  color: #eef2ff;
}

.radio {
  margin-right: 18rpx;
  display: inline-flex;
  align-items: center;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
}

.hint {
  color: rgba(226, 232, 240, 0.8);
  font-size: 24rpx;
}

.batch-tools {
  width: 100%;
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.batch-tool {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(226, 232, 240, 0.92);
}

.batch-date-scroll {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.08);
  padding: 12rpx;
  max-height: 340rpx;
}

.batch-date-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.batch-date-btn {
  width: 70rpx;
  height: 62rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.batch-date-btn.active {
  border-color: rgba(34, 197, 94, 0.75);
  background: rgba(34, 197, 94, 0.15);
}

.batch-preview {
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.04);
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.85);
}

.batch-preview-strong {
  font-weight: 800;
  color: #eef2ff;
}

.charts-wrap {
  margin-top: 18rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(226, 232, 240, 0.95);
  margin-bottom: 12rpx;
}

.chart-title-margin {
  margin-top: 18rpx;
}

.chart-empty {
  padding: 18rpx 0;
  color: rgba(226, 232, 240, 0.7);
}

.category-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}

.category-left {
  width: 240rpx;
  flex-shrink: 0;
}

.category-name {
  display: block;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.category-pct {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.75);
}

.category-bar {
  flex: 1;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.18);
  overflow: hidden;
}

.category-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.85);
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.trend-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.trend-day {
  width: 120rpx;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.8);
}

.trend-bars {
  flex: 1;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.12);
  position: relative;
  overflow: hidden;
  display: flex;
  gap: 8rpx;
  padding: 0 10rpx;
  align-items: center;
}

.trend-bar-income {
  background: rgba(34, 197, 94, 0.85);
  height: 100%;
  border-radius: 999rpx;
}

.trend-bar-expense {
  background: rgba(239, 68, 68, 0.85);
  height: 100%;
  border-radius: 999rpx;
}

.trend-values {
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.trend-income {
  color: #86efac;
  font-size: 24rpx;
}

.trend-expense {
  color: #fca5a5;
  font-size: 24rpx;
}

