/* pages/match/match.wxss */
/* 科技感匹配页样式 */

.container {
  padding: 0;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部游戏信息 */
.game-header {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  margin-bottom: 40rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(102, 126, 234, 0.15) 0%, transparent 100%);
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.game-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.game-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
}

.icon-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid rgba(102, 126, 234, 0.4);
  border-radius: 28rpx;
}

.game-info {
  flex: 1;
}

.game-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.game-players {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.6);
}

/* 通用区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
  padding: 0 30rpx;
}

.section-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.4), transparent);
}

.section-title {
  font-size: 28rpx;
  color: rgba(224, 230, 255, 0.7);
  letter-spacing: 4rpx;
}

/* 模式选择 */
.mode-section {
  padding: 0 30rpx;
}

.mode-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mode-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.9) 0%, rgba(15, 22, 50, 0.95) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 24rpx;
  overflow: hidden;
}

.card-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  opacity: 0.1;
}

.create-glow {
  background: radial-gradient(circle, #667eea 0%, transparent 70%);
}

.join-glow {
  background: radial-gradient(circle, #00d4ff 0%, transparent 70%);
}

.mode-icon-wrap {
  position: relative;
  z-index: 1;
}

.mode-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
}

.create-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.join-icon {
  background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%);
  color: #fff;
}

.mode-info {
  flex: 1;
  position: relative;
  z-index: 1;
}

.mode-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.5);
}

.mode-arrow {
  font-size: 36rpx;
  color: rgba(224, 230, 255, 0.4);
  position: relative;
  z-index: 1;
}

.mode-card:active {
  transform: scale(0.98);
  border-color: rgba(102, 126, 234, 0.5);
}

/* 加入房间 */
.join-section {
  padding: 0 30rpx;
}

.code-input-card {
  position: relative;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.9) 0%, rgba(15, 22, 50, 0.95) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.input-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 80%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.1) 0%, transparent 70%);
}

.code-input {
  position: relative;
  z-index: 1;
  width: 100%;
  font-size: 60rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  letter-spacing: 24rpx;
  background: transparent;
}

.input-placeholder {
  font-size: 32rpx;
  color: rgba(224, 230, 255, 0.3);
  letter-spacing: 4rpx;
}

.input-underline {
  position: relative;
  height: 4rpx;
  margin-top: 20rpx;
  background: rgba(102, 126, 234, 0.2);
  border-radius: 2rpx;
  overflow: hidden;
}

.underline-progress {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #00d4ff);
  border-radius: 2rpx;
  transition: width 0.3s ease;
}

.action-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: rgba(102, 126, 234, 0.2);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(224, 230, 255, 0.5);
}

.action-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
}

.action-btn .btn-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.back-link {
  text-align: center;
  color: rgba(102, 126, 234, 0.8);
  font-size: 28rpx;
  margin-top: 40rpx;
}

/* 等待匹配 */
.waiting-section {
  padding: 0 30rpx;
}

.verify-card {
  position: relative;
  background: linear-gradient(135deg, rgba(25, 35, 70, 0.9) 0%, rgba(15, 22, 50, 0.95) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 32rpx;
  padding: 50rpx;
  text-align: center;
  margin-bottom: 50rpx;
  overflow: hidden;
}

.verify-glow {
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.2) 0%, transparent 70%);
  animation: pulse 3s ease-in-out infinite;
}

.verify-label {
  display: block;
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.5);
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.verify-code-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 30rpx;
}

.verify-code {
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  color: transparent;
  position: relative;
  z-index: 1;
}

.code-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: #667eea;
  border-radius: 50%;
  animation: float-particle 2s ease-in-out infinite;
}

.p1 { top: 0; left: 20%; animation-delay: 0s; }
.p2 { top: 50%; right: 10%; background: #00d4ff; animation-delay: 0.5s; }
.p3 { bottom: 0; left: 60%; background: #f093fb; animation-delay: 1s; }

@keyframes float-particle {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.6; }
  50% { transform: translateY(-20rpx) scale(1.5); opacity: 1; }
}

.copy-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background: rgba(102, 126, 234, 0.2);
  border: 1rpx solid rgba(102, 126, 234, 0.4);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #667eea;
  position: relative;
  z-index: 1;
}

.copy-btn:active {
  background: rgba(102, 126, 234, 0.3);
}

/* 等待状态 */
.waiting-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.orbit-container {
  position: relative;
  width: 60rpx;
  height: 60rpx;
}

.orbit {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 2rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 50%;
}

.orbit-dot {
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 12rpx;
  background: #667eea;
  border-radius: 50%;
  animation: orbit 2s linear infinite;
  transform-origin: 50% 36rpx;
}

@keyframes orbit {
  to { transform: translateX(-50%) rotate(360deg); }
}

.status-info {
  display: flex;
  flex-direction: column;
}

.status-text {
  font-size: 28rpx;
  color: rgba(224, 230, 255, 0.7);
}

.status-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #667eea;
}

.waiting-tip {
  text-align: center;
  font-size: 26rpx;
  color: rgba(224, 230, 255, 0.5);
  margin-bottom: 50rpx;
}

.cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  border: 2rpx solid rgba(255, 107, 157, 0.4);
  border-radius: 50rpx;
  font-size: 32rpx;
  color: #ff6b9d;
}

.cancel-btn:active {
  background: rgba(255, 107, 157, 0.1);
}

/* 匹配成功 */
.matched-section {
  padding: 80rpx 30rpx;
  text-align: center;
}

.success-animation {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 50rpx;
}

.success-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 2rpx solid;
  border-radius: 50%;
  animation: expand 2s ease-out infinite;
}

.r1 { border-color: rgba(102, 126, 234, 0.6); animation-delay: 0s; }
.r2 { border-color: rgba(0, 212, 255, 0.4); animation-delay: 0.5s; }
.r3 { border-color: rgba(240, 147, 251, 0.3); animation-delay: 1s; }

@keyframes expand {
  0% { transform: scale(0.8); opacity: 1; }
  100% { transform: scale(1.5); opacity: 0; }
}

.success-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #00d4ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #fff;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.5);
}

.success-info {
  margin-bottom: 60rpx;
}

.success-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: rgba(224, 230, 255, 0.6);
}

.start-btn {
  position: relative;
  width: 100%;
  height: 110rpx;
  line-height: 110rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 55rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  border: none;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.5);
}

.btn-glow {
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shine 2s ease-in-out infinite;
}

@keyframes shine {
  0% { left: -100%; }
  50%, 100% { left: 150%; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
