<!--pages/match/match.wxml-->
<view class="container">
  <!-- 顶部游戏信息 -->
  <view class="game-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="game-icon-wrap">
        <image class="game-icon" src="{{game.icon}}" mode="aspectFill"></image>
        <view class="icon-ring"></view>
      </view>
      <view class="game-info">
        <text class="game-name">{{gameName}}</text>
        <text class="game-players">👥 {{game.minPlayers || 2}}-{{game.maxPlayers || 2}}人游戏</text>
      </view>
    </view>
  </view>

  <!-- 选择模式 -->
  <view wx:if="{{mode === 'select'}}" class="mode-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-title">选择匹配方式</text>
      <view class="section-line"></view>
    </view>

    <view class="mode-cards">
      <view class="mode-card" bindtap="onCreateMode">
        <view class="card-glow create-glow"></view>
        <view class="mode-icon-wrap">
          <view class="mode-icon create-icon">
            <text>+</text>
          </view>
        </view>
        <view class="mode-info">
          <text class="mode-name">创建房间</text>
          <text class="mode-desc">生成验证号邀请好友</text>
        </view>
        <view class="mode-arrow">→</view>
      </view>

      <view class="mode-card" bindtap="onJoinMode">
        <view class="card-glow join-glow"></view>
        <view class="mode-icon-wrap">
          <view class="mode-icon join-icon">
            <text>#</text>
          </view>
        </view>
        <view class="mode-info">
          <text class="mode-name">加入房间</text>
          <text class="mode-desc">输入验证号加入</text>
        </view>
        <view class="mode-arrow">→</view>
      </view>
    </view>
  </view>

  <!-- 加入房间 - 输入验证号 -->
  <view wx:if="{{mode === 'join'}}" class="join-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-title">输入验证号</text>
      <view class="section-line"></view>
    </view>

    <view class="code-input-card">
      <view class="input-glow"></view>
      <input
        class="code-input"
        type="number"
        maxlength="6"
        placeholder="请输入6位验证号"
        placeholder-class="input-placeholder"
        value="{{inputCode}}"
        bindinput="onCodeInput"
        focus="{{true}}"
      />
      <view class="input-underline">
        <view class="underline-progress" style="width: {{inputCode.length * 16.66}}%"></view>
      </view>
    </view>

    <button
      class="action-btn {{inputCode.length === 6 ? 'active' : ''}}"
      bindtap="joinRoom"
      disabled="{{loading || inputCode.length !== 6}}"
    >
      <view wx:if="{{loading}}" class="btn-loading">
        <view class="spinner"></view>
        <text>加入中...</text>
      </view>
      <text wx:else>加入房间</text>
    </button>

    <view class="back-link" bindtap="backToSelect">
      <text>← 返回选择</text>
    </view>
  </view>

  <!-- 等待匹配 -->
  <view wx:if="{{mode === 'waiting'}}" class="waiting-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-title">等待好友加入</text>
      <view class="section-line"></view>
    </view>

    <view class="verify-card">
      <view class="verify-glow"></view>
      <text class="verify-label">房间验证号</text>
      <view class="verify-code-wrap">
        <text class="verify-code">{{verifyCode}}</text>
        <view class="code-particles">
          <view class="particle p1"></view>
          <view class="particle p2"></view>
          <view class="particle p3"></view>
        </view>
      </view>
      <view class="copy-btn" bindtap="copyCode">
        <text>📋 复制验证号</text>
      </view>
    </view>

    <view class="waiting-status">
      <view class="orbit-container">
        <view class="orbit"></view>
        <view class="orbit-dot"></view>
      </view>
      <view class="status-info">
        <text class="status-text">等待玩家加入</text>
        <text class="status-count">{{room.currentPlayers}} / {{room.maxPlayers}}</text>
      </view>
    </view>

    <view class="waiting-tip">
      <text>💡 将验证号分享给好友即可匹配</text>
    </view>

    <button class="cancel-btn" bindtap="cancelMatch">取消匹配</button>
  </view>

  <!-- 匹配成功 -->
  <view wx:if="{{mode === 'matched'}}" class="matched-section">
    <view class="success-animation">
      <view class="success-ring r1"></view>
      <view class="success-ring r2"></view>
      <view class="success-ring r3"></view>
      <view class="success-icon">
        <text>✓</text>
      </view>
    </view>

    <view class="success-info">
      <text class="success-title">匹配成功</text>
      <text class="success-desc">{{room.currentPlayers}} 位玩家已就绪</text>
    </view>

    <button class="start-btn" bindtap="startGame">
      <text>🎮 开始游戏</text>
      <view class="btn-glow"></view>
    </button>
  </view>
</view>
