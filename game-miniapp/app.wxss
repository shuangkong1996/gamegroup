/**app.wxss**/
/* 全局样式 - 未来科技风格 */
page {
  background: linear-gradient(180deg, #0a0e27 0%, #1a1f3a 50%, #0d1126 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #e0e6ff;
  box-sizing: border-box;
}

/* 容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* 科技感卡片 */
.card {
  background: linear-gradient(135deg, rgba(30, 41, 82, 0.8) 0%, rgba(20, 28, 58, 0.9) 100%);
  border: 1rpx solid rgba(100, 140, 255, 0.2);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
}

.card-glow {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3),
              0 0 40rpx rgba(64, 156, 255, 0.15),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

/* 主按钮 - 渐变霓虹风格 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-size: 200% 200%;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4),
              0 0 40rpx rgba(102, 126, 234, 0.2);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #3a4a6b 0%, #2a3550 100%);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.5);
}

/* 次要按钮 */
.btn-secondary {
  background: transparent;
  color: #667eea;
  border: 2rpx solid rgba(102, 126, 234, 0.5);
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 26rpx 0;
  text-align: center;
}

/* 危险按钮 */
.btn-danger {
  background: transparent;
  color: #ff6b9d;
  border: 2rpx solid rgba(255, 107, 157, 0.5);
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 26rpx 0;
  text-align: center;
}

/* 输入框 */
.input {
  background: rgba(15, 20, 45, 0.8);
  border: 1rpx solid rgba(100, 140, 255, 0.3);
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 32rpx;
  color: #e0e6ff;
}

.input-focus {
  border-color: rgba(102, 126, 234, 0.8);
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
}

/* 文字样式 */
.text-primary {
  color: #667eea;
}

.text-accent {
  color: #00d4ff;
}

.text-gradient {
  background: linear-gradient(135deg, #667eea 0%, #00d4ff 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.text-gray {
  color: rgba(224, 230, 255, 0.6);
}

.text-center {
  text-align: center;
}

/* 间距 */
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.mb-40 { margin-bottom: 40rpx; }

/* 加载动画 */
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.4); }
  50% { box-shadow: 0 0 40rpx rgba(102, 126, 234, 0.8); }
}

/* 霓虹光晕效果 */
.neon-glow {
  animation: glow 2s ease-in-out infinite;
}
