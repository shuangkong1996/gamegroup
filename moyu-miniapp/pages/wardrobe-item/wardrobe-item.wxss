.detail-page {
  padding-bottom: 100rpx;
}

.detail-image,
.status-card,
.form-card {
  border-radius: 28rpx;
}

.detail-image {
  width: 100%;
  height: 560rpx;
  background: rgba(255, 255, 255, 0.08);
}

.status-card,
.form-card {
  margin-top: 24rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.status-title,
.field-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.status-text {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.status-error {
  display: block;
  margin-top: 10rpx;
  color: #fca5a5;
  font-size: 22rpx;
}

.field {
  margin-bottom: 24rpx;
}

.two-col {
  display: flex;
  gap: 18rpx;
}

.field-col {
  flex: 1;
}

.field-input,
.field-textarea {
  width: 100%;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  background: rgba(8, 15, 36, 0.45);
  border-radius: 20rpx;
  color: #fff;
  caret-color: #fff;
  -webkit-text-fill-color: #fff;
  box-sizing: border-box;
}

.field-input {
  min-height: 88rpx;
}

.field-input::placeholder,
.field-textarea::placeholder {
  color: rgba(255, 255, 255, 0.34);
}

.field-textarea {
  min-height: 150rpx;
}

.save-btn {
  margin-top: 24rpx;
  background: #fb923c;
  color: #1f2937;
  border-radius: 999rpx;
  font-weight: 700;
}

.status-SUCCESS {
  color: #86efac;
}

.status-PENDING,
.status-PROCESSING {
  color: #fde68a;
}

.status-FAILED {
  color: #fca5a5;
}
