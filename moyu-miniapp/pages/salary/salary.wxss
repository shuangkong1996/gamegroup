/* pages/salary/salary.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 10rpx;
}

/* 已赚卡片 */
.earning-card {
  background: linear-gradient(135deg, #ffd93d 0%, #ff9500 100%);
  border-radius: 32rpx;
  padding: 50rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.earning-label {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.6);
  display: block;
  margin-bottom: 20rpx;
}

.earning-value-wrapper {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.earning-currency {
  font-size: 48rpx;
  color: #1a1a2e;
  font-weight: bold;
  margin-right: 8rpx;
}

.earning-value {
  font-size: 88rpx;
  font-weight: bold;
  color: #1a1a2e;
  font-family: 'Courier New', monospace;
}

.earning-hint {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  display: block;
  margin-top: 20rpx;
}

/* 费率卡片 */
.rate-card {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 40rpx;
}

.rate-item {
  text-align: center;
}

.rate-label {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 12rpx;
}

.rate-value {
  font-size: 32rpx;
  color: #ffd93d;
  font-weight: bold;
}

/* 设置卡片 */
.settings-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 30rpx;
  color: #ccc;
}

.setting-input {
  width: 200rpx;
  text-align: right;
  font-size: 30rpx;
  color: #ffd93d;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.setting-picker {
  font-size: 30rpx;
  color: #ffd93d;
  padding: 16rpx 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
}

/* 底部 */
.footer {
  text-align: center;
  margin-top: 50rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #555;
}
