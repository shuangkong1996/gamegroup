.container {
  padding: 40rpx;
  padding-bottom: 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 36rpx;
}

.emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
  display: block;
}

.card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.hint-label {
  font-size: 26rpx;
  color: #f472b6;
  display: block;
  margin-bottom: 12rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #777;
  line-height: 1.5;
  display: block;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #aaa;
  display: block;
  margin-bottom: 12rpx;
}

.field-hint {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #fff;
}

.picker-value {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #ffd93d;
}

.btn-calc {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #f472b6 0%, #ec4899 100%);
  color: #1a1a2e;
  font-weight: bold;
  border-radius: 999rpx;
  font-size: 32rpx;
}

.result-title {
  font-size: 30rpx;
  color: #ffd93d;
  font-weight: bold;
  display: block;
  margin-bottom: 24rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.result-row .k {
  font-size: 28rpx;
  color: #999;
}

.result-row .v {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.result-row .v.highlight {
  color: #4ade80;
}

.schedule-toggle {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #60a5fa;
  padding: 16rpx;
}

.schedule {
  max-height: 480rpx;
  margin-top: 16rpx;
}

.sch-row {
  display: flex;
  flex-direction: row;
  padding: 14rpx 8rpx;
  font-size: 22rpx;
  color: #ccc;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.sch-head {
  color: #888;
  font-weight: bold;
}

.sch-row .c1 {
  width: 12%;
}
.sch-row .c2,
.sch-row .c3,
.sch-row .c4 {
  width: 29.33%;
  text-align: right;
}
