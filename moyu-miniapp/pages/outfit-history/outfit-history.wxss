.history-page {
  padding-bottom: 80rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card,
.empty-card {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
}

.record-date,
.record-title,
.empty-title {
  display: block;
}

.record-date {
  font-size: 24rpx;
  color: #fcd34d;
}

.record-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.record-summary,
.record-meta,
.record-link,
.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.6;
}

.record-image {
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  display: block;
  background: rgba(255, 255, 255, 0.08);
}

.record-link {
  color: #fcd34d;
}

.empty-card {
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
}
