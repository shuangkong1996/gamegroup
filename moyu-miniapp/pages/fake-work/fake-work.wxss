/* pages/fake-work/fake-work.wxss */
.container {
  min-height: 100vh;
  background: #1e1e1e;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 8rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #888;
  border-radius: 12rpx;
}

.mode-tab.active {
  background: #333;
  color: #fff;
}

/* 代码容器 */
.code-container {
  background: #1e1e1e;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #333;
}

.code-header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #2d2d2d;
  border-bottom: 1rpx solid #444;
}

.window-controls {
  display: flex;
  gap: 12rpx;
  margin-right: 30rpx;
}

.control {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.control.red { background: #ff5f56; }
.control.yellow { background: #ffbd2e; }
.control.green { background: #27ca40; }

.file-name {
  font-size: 24rpx;
  color: #aaa;
}

.code-content {
  height: 600rpx;
  padding: 20rpx;
}

.code-line {
  display: flex;
  line-height: 1.8;
  font-family: 'Courier New', monospace;
}

.line-number {
  width: 60rpx;
  color: #555;
  font-size: 24rpx;
  text-align: right;
  margin-right: 30rpx;
  user-select: none;
}

.line-code {
  font-size: 24rpx;
  color: #d4d4d4;
  white-space: pre;
}

.cursor-blink {
  position: absolute;
  width: 4rpx;
  height: 32rpx;
  background: #fff;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 文档容器 */
.doc-container {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.doc-toolbar {
  display: flex;
  padding: 16rpx 30rpx;
  background: #f3f3f3;
  border-bottom: 1rpx solid #ddd;
}

.toolbar-item {
  font-size: 24rpx;
  color: #333;
  margin-right: 40rpx;
}

.doc-content {
  height: 600rpx;
  padding: 40rpx;
  background: #fff;
}

.doc-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 加载容器 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 600rpx;
}

.loading-box {
  text-align: center;
  padding: 60rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  width: 80%;
}

.loading-icon {
  margin-bottom: 40rpx;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: #4ade80;
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  color: #ccc;
  display: block;
  margin-bottom: 40rpx;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4ade80, #22c55e);
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #4ade80;
}

/* 提示 */
.hint {
  text-align: center;
  margin-top: 40rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #555;
}
