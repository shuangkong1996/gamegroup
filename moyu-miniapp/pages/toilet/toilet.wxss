/* pages/toilet/toilet.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
  margin-top: 10rpx;
}

/* 计时器卡片 */
.timer-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  padding: 60rpx;
  text-align: center;
  margin-bottom: 40rpx;
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.timer-card.running {
  border-color: #4ade80;
  background: rgba(74, 222, 128, 0.1);
}

.timer-display {
  font-size: 120rpx;
  font-weight: bold;
  color: #fff;
  font-family: 'Courier New', monospace;
  display: block;
}

.money-display {
  margin-top: 30rpx;
}

.money-label {
  font-size: 28rpx;
  color: #888;
  margin-right: 16rpx;
}

.money-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #4ade80;
}

/* 按钮 */
.button-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 50rpx;
}

.action-btn {
  width: 300rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
}

.action-btn.start {
  background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
  color: #fff;
}

.action-btn.stop {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #fff;
}

.action-btn:active {
  transform: scale(0.95);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffd93d;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 历史记录 */
.history-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 30rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  color: #ccc;
}

.history-clear {
  font-size: 24rpx;
  color: #ef4444;
}

.history-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 26rpx;
  color: #888;
  flex: 1;
}

.history-duration {
  font-size: 26rpx;
  color: #ccc;
  margin: 0 30rpx;
}

.history-earned {
  font-size: 26rpx;
  color: #4ade80;
}

/* 底部 */
.footer {
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #555;
}
