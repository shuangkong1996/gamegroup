.ledger-page {
  min-height: 100vh;
  background: radial-gradient(circle at 12% 8%, rgba(255, 217, 61, 0.14) 0%, transparent 38%),
    radial-gradient(circle at 92% 12%, rgba(96, 165, 250, 0.10) 0%, transparent 36%),
    linear-gradient(180deg, #0f172a 0%, #111827 100%);
  color: #eef2ff;
  padding: 22rpx;
  box-sizing: border-box;
}

.ledger-page.no-scroll {
  height: 100vh;
  overflow: hidden;
}

.card {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 26rpx;
  padding: 20rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.26);
}

.header-card {
  border-color: rgba(255, 217, 61, 0.14);
  background: linear-gradient(180deg, rgba(255, 217, 61, 0.08) 0%, rgba(255, 255, 255, 0.06) 100%);
}

.card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 14rpx;
}

.toolbar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar-item {
  flex: 1;
  min-width: 200rpx;
}

.mode-switch {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.mode-radio {
  margin-right: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.82);
  margin-bottom: 8rpx;
}

.picker-display {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.16);
}

.picker-text {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.92);
}

.toolbar-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 22rpx;
  padding: 14rpx;
}

.stat-title {
  display: block;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.80);
}

.stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.stat.income .stat-value {
  color: #4ade80;
}

.stat.expense .stat-value {
  color: #fb7185;
}

.toolbar-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.mini-btn {
  flex: 1;
  height: 76rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.2rpx;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  background: linear-gradient(135deg, rgba(255, 217, 61, 0.98) 0%, rgba(255, 196, 0, 0.98) 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.24);
  transform: translateZ(0);
}

.mini-btn.primary { color: #111827; }

.mini-btn:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.loading-wrap,
.empty {
  padding: 32rpx 0;
  text-align: center;
  color: rgba(226, 232, 240, 0.8);
}

.content {
  margin-top: 16rpx;
}

.content.card {
  margin-top: 18rpx;
}

.day-group {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.day-header {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.12);
}

.day-date {
  font-size: 26rpx;
  font-weight: 700;
}

.day-sum {
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.85);
}

.record-item {
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(226, 232, 240, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-remark {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(226, 232, 240, 0.70);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.record-money {
  font-size: 26rpx;
  font-weight: 700;
}

.record-money.income {
  color: #22c55e;
}

.record-money.expense {
  color: #ef4444;
}

.record-del {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
  background: rgba(239, 68, 68, 0.16);
  color: #fecaca;
  border-radius: 12rpx;
  border: none;
}

.record-del::after {
  border: none;
}

.load-more {
  width: 100%;
  margin-top: 10rpx;
}

.fab {
  position: fixed;
  right: 24rpx;
  bottom: 120rpx;
  z-index: 10;
}

.fab-btn {
  background: linear-gradient(135deg, rgba(255, 217, 61, 0.98) 0%, rgba(255, 196, 0, 0.98) 100%);
  color: #111827;
  border: none;
  height: 82rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-weight: 900;
}

.fab-btn::after {
  border: none;
}

.fab-plus {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
}

.fab-label {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.modal-wrap {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.58);
  animation: modalMaskFadeIn 220ms ease-out;
}

.modal {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0b1733 0%, #0f172a 100%);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  border: 1px solid rgba(125, 211, 252, 0.22);
  padding: 18rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow:
    0 -6rpx 28rpx rgba(125, 211, 252, 0.18),
    0 -10rpx 42rpx rgba(255, 217, 61, 0.14),
    0 18rpx 48rpx rgba(0, 0, 0, 0.42);
  animation: modalSlideUp 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

.modal .picker-display {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.14);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.modal-title-strong {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 10rpx 0 8rpx;
  margin-bottom: 16rpx;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.modal-title-strong::before {
  content: '';
  width: 10rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 217, 61, 0.95);
  box-shadow: 0 8rpx 18rpx rgba(255, 217, 61, 0.25);
}

.modal-title-text {
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 0.6rpx;
  color: rgba(255, 255, 255, 0.96);
  text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.1);
}

@keyframes modalSlideUp {
  from {
    transform: translateY(100%);
    opacity: 0.84;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes modalMaskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.form-row {
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  min-height: 84rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  color: #eef2ff;
  line-height: 1.2;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 14rpx;
  box-sizing: border-box;
  color: #eef2ff;
}

.radio {
  margin-right: 18rpx;
  display: inline-flex;
  align-items: center;
}

.modal-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.modal-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
  padding-top: 12rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.98);
}

.batch-tools {
  width: 100%;
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.batch-tool {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(226, 232, 240, 0.92);
}

.batch-date-scroll {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.08);
  padding: 12rpx;
}

.calendar-week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin: 4rpx 0 10rpx;
}

.week-item {
  text-align: center;
  color: rgba(226, 232, 240, 0.8);
  font-size: 22rpx;
  font-weight: 700;
}

.batch-date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.batch-date-btn {
  height: 62rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(148, 163, 184, 0.45);
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 120ms ease;
}

.batch-date-btn.active {
  border-color: rgba(255, 217, 61, 0.95);
  background: rgba(255, 217, 61, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(255, 217, 61, 0.25);
}

.batch-date-btn.weekend {
  border-color: rgba(96, 165, 250, 0.35);
  background: rgba(96, 165, 250, 0.08);
}

.batch-date-btn.weekend.active {
  border-color: rgba(255, 217, 61, 0.95);
  background: rgba(255, 217, 61, 0.92);
}

.batch-date-text {
  color: rgba(226, 232, 240, 0.95);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.batch-date-btn.adjacent {
  border-color: rgba(100, 116, 139, 0.22);
  background: rgba(15, 23, 42, 0.35);
}

.batch-date-btn.adjacent .batch-date-text {
  color: rgba(148, 163, 184, 0.55);
}

.batch-date-btn.active .batch-date-text {
  color: #111827;
}

.batch-preview {
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.04);
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.85);
}

.batch-preview-strong {
  font-weight: 800;
  color: #eef2ff;
}

.charts-wrap {
  margin-top: 18rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(226, 232, 240, 0.95);
  margin-bottom: 12rpx;
}

.chart-title-margin {
  margin-top: 18rpx;
}

.chart-empty {
  padding: 18rpx 0;
  color: rgba(226, 232, 240, 0.7);
}

.category-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}

.category-left {
  width: 240rpx;
  flex-shrink: 0;
}

.category-name {
  display: block;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.category-pct {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.75);
}

.category-bar {
  flex: 1;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.18);
  overflow: hidden;
}

.category-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.85);
}

.trend-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.trend-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.trend-day {
  width: 120rpx;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.8);
}

.trend-bars {
  flex: 1;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.12);
  position: relative;
  overflow: hidden;
  display: flex;
  gap: 8rpx;
  padding: 0 10rpx;
  align-items: center;
}

.trend-bar-income {
  background: rgba(34, 197, 94, 0.85);
  height: 100%;
  border-radius: 999rpx;
}

.trend-bar-expense {
  background: rgba(239, 68, 68, 0.85);
  height: 100%;
  border-radius: 999rpx;
}

.trend-values {
  width: 220rpx;
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.trend-income {
  color: #86efac;
  font-size: 24rpx;
}

.trend-expense {
  color: #fca5a5;
  font-size: 24rpx;
}

