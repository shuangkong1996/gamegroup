.ledger-page {
  min-height: 100vh;
  background: radial-gradient(circle at 12% 8%, rgba(255, 217, 61, 0.14) 0%, transparent 38%),
    radial-gradient(circle at 92% 12%, rgba(96, 165, 250, 0.10) 0%, transparent 36%),
    linear-gradient(180deg, #0f172a 0%, #111827 100%);
  color: #eef2ff;
  padding: 22rpx;
  box-sizing: border-box;
}

.ledger-page.no-scroll {
  height: 100vh;
  overflow: hidden;
}

.card {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 26rpx;
  padding: 20rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.26);
}

.header-card {
  border-color: rgba(255, 217, 61, 0.14);
  background: linear-gradient(180deg, rgba(255, 217, 61, 0.08) 0%, rgba(255, 255, 255, 0.06) 100%);
}

.card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 14rpx;
}

.toolbar-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar-item {
  flex: 1;
  min-width: 200rpx;
}

.mode-switch {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.mode-radio {
  margin-right: 0;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.82);
  margin-bottom: 8rpx;
}

.picker-display {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.16);
}

.picker-text {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.92);
}

.toolbar-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 22rpx;
  padding: 14rpx;
}

.stat-title {
  display: block;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.80);
}

.stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.stat.income .stat-value {
  color: #4ade80;
}

.stat.expense .stat-value {
  color: #fb7185;
}

.toolbar-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.mini-btn {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.2rpx;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  background: linear-gradient(135deg, rgba(255, 217, 61, 0.98) 0%, rgba(255, 196, 0, 0.98) 100%);
  border: none;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.24);
  transform: translateZ(0);
}

.mini-btn.primary { color: #111827; }

.mini-btn:active {
  opacity: 0.92;
  transform: scale(0.99);
}

.loading-wrap,
.empty {
  padding: 32rpx 0;
  text-align: center;
  color: rgba(226, 232, 240, 0.8);
}

.content {
  margin-top: 16rpx;
}

.content.card {
  margin-top: 18rpx;
}

.day-group {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.day-header {
  padding: 16rpx;
  display: flex;
  justify-content: space-between;
  background: rgba(0, 0, 0, 0.12);
}

.day-date {
  font-size: 26rpx;
  font-weight: 700;
}

.day-sum {
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.85);
}

.record-item {
  padding: 14rpx 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.record-left {
  flex: 1;
  min-width: 0;
}

.record-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(226, 232, 240, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-remark {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(226, 232, 240, 0.70);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.record-money {
  font-size: 26rpx;
  font-weight: 700;
}

.record-money.income {
  color: #22c55e;
}

.record-money.expense {
  color: #ef4444;
}

.record-del {
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
  background: rgba(239, 68, 68, 0.16);
  color: #fecaca;
  border-radius: 12rpx;
  border: none;
}

.record-del::after {
  border: none;
}

.load-more {
  width: 100%;
  margin-top: 10rpx;
}

.modal-wrap {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.58);
  animation: modalMaskFadeIn 220ms ease-out;
}

.modal {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #0b1733 0%, #0f172a 100%);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  border: 1px solid rgba(125, 211, 252, 0.22);
  padding: 18rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow:
    0 -6rpx 28rpx rgba(125, 211, 252, 0.18),
    0 -10rpx 42rpx rgba(255, 217, 61, 0.14),
    0 18rpx 48rpx rgba(0, 0, 0, 0.42);
  animation: modalSlideUp 260ms cubic-bezier(0.22, 1, 0.36, 1);
}

.modal .picker-display {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.14);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.modal-title-strong {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 10rpx 0 8rpx;
  margin-bottom: 16rpx;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.modal-title-strong::before {
  content: '';
  width: 10rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 217, 61, 0.95);
  box-shadow: 0 8rpx 18rpx rgba(255, 217, 61, 0.25);
}

.modal-title-text {
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 0.6rpx;
  color: rgba(255, 255, 255, 0.96);
  text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.1);
}

@keyframes modalSlideUp {
  from {
    transform: translateY(100%);
    opacity: 0.84;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes modalMaskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.form-row {
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  min-height: 84rpx;
  padding: 18rpx 16rpx;
  box-sizing: border-box;
  color: #eef2ff;
  line-height: 1.2;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(0, 0, 0, 0.12);
  border-radius: 14rpx;
  padding: 14rpx;
  box-sizing: border-box;
  color: #eef2ff;
}

.radio {
  margin-right: 18rpx;
  display: inline-flex;
  align-items: center;
}

.modal-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.modal-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
  padding-top: 12rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.98);
}

.batch-tools {
  width: 100%;
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.batch-tool {
  flex: 1;
  width: auto;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(226, 232, 240, 0.92);
}

.batch-date-scroll {
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.08);
  padding: 12rpx;
}

.calendar-week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin: 4rpx 0 10rpx;
}

.week-item {
  text-align: center;
  color: rgba(226, 232, 240, 0.8);
  font-size: 22rpx;
  font-weight: 700;
}

.batch-date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.batch-date-btn {
  height: 62rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(148, 163, 184, 0.45);
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 120ms ease;
}

.batch-date-btn.active {
  border-color: rgba(255, 217, 61, 0.95);
  background: rgba(255, 217, 61, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(255, 217, 61, 0.25);
}

.batch-date-btn.weekend {
  border-color: rgba(96, 165, 250, 0.35);
  background: rgba(96, 165, 250, 0.08);
}

.batch-date-btn.weekend.active {
  border-color: rgba(255, 217, 61, 0.95);
  background: rgba(255, 217, 61, 0.92);
}

.batch-date-text {
  color: rgba(226, 232, 240, 0.95);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 700;
}

.batch-date-btn.adjacent {
  border-color: rgba(100, 116, 139, 0.22);
  background: rgba(15, 23, 42, 0.35);
}

.batch-date-btn.adjacent .batch-date-text {
  color: rgba(148, 163, 184, 0.55);
}

.batch-date-btn.active .batch-date-text {
  color: #111827;
}

.batch-preview {
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(255, 255, 255, 0.04);
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.85);
}

.batch-preview-strong {
  font-weight: 800;
  color: #eef2ff;
}

/* Refined ledger layout */
.ledger-page {
  min-height: 100vh;
  padding: 0 24rpx 160rpx;
  background: linear-gradient(180deg, #111a1a 0%, #101615 42%, #0d1212 100%);
  color: #eef4ef;
}

.ledger-page.no-scroll {
  position: fixed;
  inset: 0;
  height: 100vh;
  overflow: hidden;
}

.ledger-hero {
  margin: 0 -24rpx;
  padding: 42rpx 24rpx 28rpx;
  background: linear-gradient(155deg, #1b2925 0%, #14201d 54%, #131b19 100%);
  border-bottom: 1px solid rgba(191, 220, 201, 0.12);
}

.hero-topline,
.filter-heading,
.overview-heading,
.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-topline {
  position: relative;
  margin-bottom: 28rpx;
}

.hero-topline > view {
  min-width: 0;
}

.eyebrow {
  display: block;
  color: #8fa99a;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #f5faf6;
}

.icon-action {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(235, 247, 238, 0.09);
  border: 1px solid rgba(235, 247, 238, 0.15);
  color: #c8f276;
  font-size: 42rpx;
  line-height: 68rpx;
}

.mode-option::after,
.list-action::after {
  border: 0;
}

.filter-panel {
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(7, 13, 11, 0.28);
  border: 1px solid rgba(207, 229, 214, 0.10);
}

.filter-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.section-label {
  color: #c3d2c7;
  font-size: 23rpx;
  font-weight: 650;
}

.mode-switch {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  gap: 4rpx;
  padding: 4rpx;
  background: rgba(0, 0, 0, 0.24);
  border-radius: 12rpx;
}

.mode-option {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 48rpx;
  margin: 0;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 9rpx;
  background: transparent;
  color: #9aada1;
  font-size: 21rpx;
  line-height: 48rpx;
}

.mode-option.active {
  background: #c8f276;
  color: #172018;
  font-weight: 750;
  box-shadow: 0 4rpx 16rpx rgba(148, 190, 79, 0.22);
}

.filter-controls {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.filter-value {
  min-width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  box-sizing: border-box;
  border-radius: 11rpx;
  background: rgba(235, 247, 238, 0.07);
  border: 1px solid rgba(235, 247, 238, 0.09);
  color: #edf4ee;
  font-size: 22rpx;
}

.filter-value text:first-child {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chevron {
  color: #9bb29f;
  font-size: 26rpx;
  flex-shrink: 0;
}

.overview-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1px solid rgba(204, 230, 213, 0.13);
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(35, 56, 46, 0.96), rgba(25, 40, 34, 0.98));
  animation: overviewEnter 380ms ease-out both;
}

.period-label {
  max-width: 52%;
  color: #98ad9f;
  font-size: 20rpx;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.overview-balance {
  margin-top: 24rpx;
}

.overview-caption {
  display: block;
  color: #9fb1a4;
  font-size: 21rpx;
}

.overview-total {
  display: block;
  margin-top: 7rpx;
  color: #f3f8f3;
  font-size: 48rpx;
  font-weight: 760;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.overview-divider {
  height: 1px;
  margin: 22rpx 0;
  background: rgba(217, 236, 222, 0.12);
}

.overview-split {
  display: flex;
  gap: 24rpx;
}

.overview-split > view {
  flex: 1;
  min-width: 0;
}

.overview-income,
.overview-expense {
  display: block;
  margin-top: 7rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.overview-income { color: #b9e985; }
.overview-expense { color: #f1a39a; }

.stats-link {
  width: 100%;
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  border-radius: 15rpx;
  background: rgba(218, 239, 224, 0.07);
  border: 1px solid rgba(218, 239, 224, 0.1);
  color: #eef5ef;
}

.stats-link-title,
.stats-link-subtitle {
  display: block;
}

.stats-link-title { font-size: 24rpx; font-weight: 720; }
.stats-link-subtitle { margin-top: 4rpx; color: #9cad9f; font-size: 19rpx; }
.stats-link-arrow { color: #c8f276; font-size: 21rpx; }

.list-heading {
  display: block;
  padding: 30rpx 2rpx 16rpx;
}

.list-heading-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.list-title {
  color: #f1f5f1;
  font-size: 30rpx;
  font-weight: 760;
}

.list-count {
  color: #8fa098;
  font-size: 20rpx;
}

.list-actions {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  gap: 12rpx;
  margin-top: 14rpx;
}

.list-action {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: rgba(197, 229, 205, 0.08);
  border: 1px solid rgba(197, 229, 205, 0.14);
  color: #bed3c4;
  font-size: 21rpx;
  line-height: 54rpx;
}

.list-action-primary {
  background: #c8f276;
  border-color: #c8f276;
  color: #172018;
  font-weight: 750;
}

.content.card {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
}

.day-group {
  margin-bottom: 14rpx;
  overflow: hidden;
  border: 1px solid rgba(207, 224, 211, 0.1);
  border-radius: 16rpx;
  background: rgba(230, 242, 233, 0.045);
}

.day-header { background: rgba(213, 235, 219, 0.055); }
.day-date { color: #d4e2d7; }
.day-sum { color: #9eafa3; }
.record-item { border-color: rgba(207, 224, 211, 0.08); }
.record-title { color: #e6eee8; }
.record-remark { color: #9eaaa1; }
.record-money { font-variant-numeric: tabular-nums; }
.record-del { background: transparent; color: #d4948d; font-weight: 600; }

.empty {
  padding: 64rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1px dashed rgba(207, 224, 211, 0.15);
  border-radius: 16rpx;
  color: #c6d3ca;
  font-size: 24rpx;
}

.empty-mark { color: #c8f276; font-size: 52rpx; line-height: 1; }
.empty-hint { margin-top: 10rpx; color: #87978d; font-size: 20rpx; }

.modal {
  width: 100%;
  height: 86vh;
  max-height: 86vh;
  box-sizing: border-box;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  border: 1px solid rgba(191, 220, 201, 0.18);
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
  background: linear-gradient(180deg, #1b2823 0%, #121a17 100%);
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.38);
}

.modal-title-strong {
  flex-shrink: 0;
  padding: 10rpx 0 18rpx;
  border-color: rgba(191, 220, 201, 0.12);
}

.modal-title-strong::before {
  background: #c8f276;
  box-shadow: none;
}

.modal-title-text {
  font-size: 31rpx;
  letter-spacing: 0;
  text-shadow: none;
}

.modal-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.modal-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding-bottom: 10rpx;
}

.modal-actions {
  flex-shrink: 0;
  padding: 16rpx 0 2rpx;
  margin-top: 0;
  background: #121a17;
  border-top: 1px solid rgba(191, 220, 201, 0.11);
}

.modal .picker-display,
.modal .input,
.modal .textarea {
  border-color: rgba(191, 220, 201, 0.16);
  border-radius: 12rpx;
  background: rgba(3, 8, 6, 0.25);
}

.batch-date-scroll {
  border-color: rgba(191, 220, 201, 0.14);
  border-radius: 12rpx;
}

.batch-date-btn { border-radius: 11rpx; }
.batch-date-btn { position: relative; }
.calendar-marker {
  position: absolute;
  top: 3rpx;
  right: 5rpx;
  color: #9db1a2;
  font-size: 14rpx;
  line-height: 1;
}
.batch-date-btn.makeup { border-color: rgba(200, 242, 118, 0.56); }
.batch-date-btn.holiday { border-color: rgba(225, 155, 142, 0.5); }
.batch-date-btn.active .calendar-marker { color: #273322; }
.calendar-source-hint {
  display: block;
  margin: 0 0 10rpx;
  color: rgba(190, 207, 195, 0.72);
  font-size: 18rpx;
}

@keyframes overviewEnter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
