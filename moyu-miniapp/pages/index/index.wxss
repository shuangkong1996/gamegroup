/* pages/index/index.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.date {
  font-size: 32rpx;
  color: #a0a0a0;
}

.greeting {
  display: block;
  font-size: 36rpx;
  color: #ffd93d;
  margin-top: 16rpx;
  font-weight: bold;
}

/* 通用卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 30rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 24rpx;
  color: #666;
}

.countdown-card .card-subtitle {
  color: #ffd93d;
  font-size: 26rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

/* 下班倒计时卡片 */
.countdown-card {
  background: linear-gradient(135deg, rgba(255, 217, 61, 0.15) 0%, rgba(255, 107, 107, 0.15) 100%);
  border: 1rpx solid rgba(255, 217, 61, 0.3);
  position: relative;
  transition: all 0.3s;
}

.countdown-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.countdown-display {
  text-align: center;
  margin: 30rpx 0;
}

.countdown-text {
  font-size: 88rpx;
  font-weight: bold;
  color: #ffd93d;
  font-family: 'Courier New', monospace;
  letter-spacing: 8rpx;
}

.countdown-text.off-work {
  font-size: 56rpx;
  color: #4ade80;
  letter-spacing: 0;
}

.countdown-hint {
  text-align: center;
}

.countdown-hint text {
  font-size: 26rpx;
  color: #a0a0a0;
}

/* 语录卡片 */
.quote-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
  border: 1rpx solid rgba(102, 126, 234, 0.3);
}

.quote-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.quote-emoji {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.quote-text {
  font-size: 32rpx;
  color: #e0e0e0;
  text-align: center;
  line-height: 1.6;
}

/* 周末卡片 */
.weekend-card {
  background: rgba(74, 222, 128, 0.1);
  border: 1rpx solid rgba(74, 222, 128, 0.3);
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-label {
  font-size: 32rpx;
  color: #a0a0a0;
}

.card-value {
  font-size: 36rpx;
  color: #4ade80;
  font-weight: bold;
}

.card-value.highlight {
  color: #ffd93d;
}

/* 节假日卡片 */
.holiday-card {
  background: rgba(255, 255, 255, 0.05);
}

.holiday-list {
  margin-top: 10rpx;
}

.holiday-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.holiday-item:last-child {
  border-bottom: none;
}

.holiday-left {
  display: flex;
  align-items: center;
}

.holiday-emoji {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.holiday-name {
  font-size: 30rpx;
  color: #e0e0e0;
}

.holiday-right {
  display: flex;
  align-items: baseline;
}

.holiday-days {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd93d;
}

.holiday-unit {
  font-size: 24rpx;
  color: #a0a0a0;
  margin-left: 8rpx;
}

/* 底部 */
.footer {
  text-align: center;
  margin-top: 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #555;
}
