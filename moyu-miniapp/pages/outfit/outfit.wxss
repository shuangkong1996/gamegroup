.outfit-page {
  padding-bottom: 100rpx;
}

.weather-card,
.city-card,
.plan-card,
.items-card {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.city-title {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
}

.city-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.city-input {
  flex: 1;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(8, 15, 36, 0.45);
  color: #fff;
}

.city-btn {
  margin: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.control-card {
  margin-bottom: 24rpx;
}

.readonly-tip {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(34, 211, 238, 0.12);
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.6;
}

.weather-card {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.22), rgba(251, 146, 60, 0.18));
}

.mode-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mode-row--wrap {
  flex-wrap: wrap;
}

.mode-chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.mode-chip--active {
  background: rgba(251, 146, 60, 0.18);
  border-color: rgba(251, 146, 60, 0.42);
  color: #ffd8b5;
}

.plan-title--sub {
  margin-top: 24rpx;
  font-size: 28rpx;
}

.generate-btn {
  margin-top: 24rpx;
}

.refresh-btn {
  margin-top: 20rpx;
}

.weather-city,
.plan-title,
.outfit-name {
  display: block;
  font-weight: 700;
}

.weather-city {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.weather-main {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
}

.weather-sub,
.plan-summary,
.plan-reason,
.plan-tip,
.outfit-role {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.6;
}

.plan-title {
  font-size: 34rpx;
}

.outfit-item {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.outfit-item:last-child {
  margin-bottom: 0;
}

.outfit-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
}

.outfit-image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.outfit-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.render-image {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 22rpx;
  display: block;
  background: rgba(255, 255, 255, 0.08);
}

.items-card .actions {
  margin-top: 24rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  border-radius: 999rpx;
  font-weight: 700;
}

.primary-btn {
  background: #fb923c;
  color: #1f2937;
}

.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.empty-card {
  text-align: center;
}
