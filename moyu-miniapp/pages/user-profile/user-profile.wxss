.profile-page {
  padding-bottom: 100rpx;
}

.hero-card,
.status-card,
.section-card,
.input-card,
.upload-card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
}

.hero-card {
  padding: 34rpx;
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(251, 146, 60, 0.18));
}

.hero-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.72);
}

.status-grid {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.status-card {
  flex: 1;
  padding: 24rpx;
}

.status-card--done {
  border-color: rgba(74, 222, 128, 0.36);
  background: rgba(74, 222, 128, 0.1);
}

.status-label,
.field-label,
.upload-title {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.status-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.section-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-tip,
.switch-tip {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.56);
}

.field-block {
  margin-top: 24rpx;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.chip-row--wrap {
  flex-wrap: wrap;
}

.choice-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.choice-chip--active {
  background: rgba(251, 146, 60, 0.18);
  border-color: rgba(251, 146, 60, 0.42);
  color: #ffd8b5;
}

.inline-fields {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.input-card {
  padding: 24rpx;
}

.input-card--half {
  flex: 1;
}

.field-input {
  width: 100%;
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  min-height: 88rpx;
  line-height: 52rpx;
  border-radius: 20rpx;
  background: rgba(8, 15, 36, 0.45);
  color: #ffffff;
  box-sizing: border-box;
}

.field-input--solo {
  margin-top: 16rpx;
}

.field-unit {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.52);
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  line-height: 1.7;
  border-radius: 20rpx;
  background: rgba(8, 15, 36, 0.45);
  color: #ffffff;
  box-sizing: border-box;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.upload-card {
  padding: 22rpx;
}

.upload-card--single {
  margin-top: 24rpx;
}

.preface-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(251, 146, 60, 0.12);
  border: 1rpx solid rgba(251, 146, 60, 0.24);
}

.preface-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffe7cf;
}

.preface-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.68);
}

.upload-preview,
.upload-empty {
  margin-top: 14rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(8, 15, 36, 0.45);
}

.upload-image {
  display: block;
  width: 100%;
  height: 240rpx;
}

.upload-empty {
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.5);
}

.upload-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ghost-btn {
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
}

.clear-link {
  font-size: 24rpx;
  color: #fca5a5;
}

.switch-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.save-btn {
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: #fb923c;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
}
