<view class="container profile-page">
  <view class="hero-card">
    <text class="hero-title">形象资料</text>
    <text class="hero-subtitle">先把基础资料整理好，后续可以结合照片和衣柜内容，给你更贴合的穿衣参考。</text>
  </view>

  <view class="status-grid" wx:if="{{profile}}">
    <view class="status-card {{profile.basicInfoCompleted ? 'status-card--done' : ''}}">
      <text class="status-label">基础信息</text>
      <text class="status-value">{{profile.basicInfoCompleted ? '已补充' : '待完善'}}</text>
    </view>
    <view class="status-card {{profile.imageInfoCompleted ? 'status-card--done' : ''}}">
      <text class="status-label">资料照片</text>
      <text class="status-value">{{profile.imageInfoCompleted ? '已补充' : '待完善'}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">身体基础信息</text>
      <text class="section-tip">用于整理更贴合你的穿搭资料</text>
    </view>

    <view class="field-block">
      <text class="field-label">性别</text>
      <view class="chip-row">
        <view
          wx:for="{{genderOptions}}"
          wx:key="*this"
          class="choice-chip {{form.gender === item ? 'choice-chip--active' : ''}}"
          data-value="{{item}}"
          bindtap="onGenderTap">
          {{item}}
        </view>
      </view>
    </view>

    <view class="inline-fields">
      <view class="input-card input-card--half">
        <text class="field-label">身高</text>
        <input class="field-input" type="number" placeholder="例如 168" value="{{form.heightCm}}" data-field="heightCm" bindinput="onInputChange" />
        <text class="field-unit">cm</text>
      </view>
      <view class="input-card input-card--half">
        <text class="field-label">体重</text>
        <input class="field-input" type="digit" placeholder="例如 52.5" value="{{form.weightKg}}" data-field="weightKg" bindinput="onInputChange" />
        <text class="field-unit">kg</text>
      </view>
    </view>

    <view class="field-block">
      <text class="field-label">平日穿搭风格</text>
      <view class="chip-row chip-row--wrap">
        <view
          wx:for="{{styleOptions}}"
          wx:key="*this"
          class="choice-chip {{form.dailyStyle === item ? 'choice-chip--active' : ''}}"
          data-value="{{item}}"
          bindtap="onStyleTap">
          {{item}}
        </view>
      </view>
      <input class="field-input field-input--solo" placeholder="也可以自己填写，例如美式复古、极简黑白" value="{{form.dailyStyle}}" data-field="dailyStyle" bindinput="onInputChange" />
    </view>

    <view class="field-block">
      <text class="field-label">补充备注</text>
      <textarea class="field-textarea" maxlength="500" placeholder="例如常穿通勤装、希望弱化肩宽、偏爱浅色系等" value="{{form.bodyNote}}" data-field="bodyNote" bindinput="onInputChange"></textarea>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">资料照片</text>
      <text class="section-tip">建议准备面部、正面全身、侧面全身三张清晰照片</text>
    </view>

    <view class="upload-grid">
      <view class="upload-card">
        <text class="upload-title">面部照片</text>
        <view wx:if="{{form.faceImageUrl}}" class="upload-preview" data-url="{{form.faceImageUrl}}" bindtap="onPreviewImage">
          <image class="upload-image" src="{{form.faceImageUrl}}" mode="aspectFill"></image>
        </view>
        <view wx:else class="upload-empty">正脸、光线均匀</view>
        <view class="upload-actions">
          <button class="ghost-btn" data-field="faceImageUrl" bindtap="onUploadImage" loading="{{uploadingField === 'faceImageUrl'}}">{{form.faceImageUrl ? '更换' : '上传'}}</button>
          <text wx:if="{{form.faceImageUrl}}" class="clear-link" data-field="faceImageUrl" bindtap="onClearImage">清空</text>
        </view>
      </view>

      <view class="upload-card">
        <text class="upload-title">正面全身</text>
        <view wx:if="{{form.frontBodyImageUrl}}" class="upload-preview" data-url="{{form.frontBodyImageUrl}}" bindtap="onPreviewImage">
          <image class="upload-image" src="{{form.frontBodyImageUrl}}" mode="aspectFill"></image>
        </view>
        <view wx:else class="upload-empty">站姿自然，完整入镜</view>
        <view class="upload-actions">
          <button class="ghost-btn" data-field="frontBodyImageUrl" bindtap="onUploadImage" loading="{{uploadingField === 'frontBodyImageUrl'}}">{{form.frontBodyImageUrl ? '更换' : '上传'}}</button>
          <text wx:if="{{form.frontBodyImageUrl}}" class="clear-link" data-field="frontBodyImageUrl" bindtap="onClearImage">清空</text>
        </view>
      </view>

      <view class="upload-card">
        <text class="upload-title">侧面全身</text>
        <view wx:if="{{form.sideBodyImageUrl}}" class="upload-preview" data-url="{{form.sideBodyImageUrl}}" bindtap="onPreviewImage">
          <image class="upload-image" src="{{form.sideBodyImageUrl}}" mode="aspectFill"></image>
        </view>
        <view wx:else class="upload-empty">方便补充整体轮廓</view>
        <view class="upload-actions">
          <button class="ghost-btn" data-field="sideBodyImageUrl" bindtap="onUploadImage" loading="{{uploadingField === 'sideBodyImageUrl'}}">{{form.sideBodyImageUrl ? '更换' : '上传'}}</button>
          <text wx:if="{{form.sideBodyImageUrl}}" class="clear-link" data-field="sideBodyImageUrl" bindtap="onClearImage">清空</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">搭配偏好</text>
      <text class="section-tip">后续整理穿衣参考时会用到</text>
    </view>

    <view class="preface-card">
      <text class="preface-title">面部照片会直接作为后续参考图</text>
      <text class="preface-desc">不用再额外上传一张参考面部照片，减少一次操作。</text>
    </view>

    <view class="switch-row">
      <view>
        <text class="field-label">优先使用衣柜中的衣服</text>
        <text class="switch-tip">开启后，后续穿衣参考会默认优先结合你已上传的衣物</text>
      </view>
      <switch color="#fb923c" checked="{{form.useWardrobeItems}}" bindchange="onUseWardrobeChange" />
    </view>
  </view>

  <button class="save-btn" bindtap="onSave" loading="{{saving}}">保存资料</button>
</view>
