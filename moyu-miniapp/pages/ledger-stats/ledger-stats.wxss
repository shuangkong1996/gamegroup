.stats-page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #111a1a 0%, #101615 48%, #0d1212 100%);
  color: #edf4ee;
}

.stats-hero {
  margin: 0 -24rpx;
  padding: 40rpx 24rpx 26rpx;
  background: linear-gradient(155deg, #1b2925 0%, #14201d 66%, #131b19 100%);
  border-bottom: 1px solid rgba(191, 220, 201, 0.12);
}

.stats-eyebrow { display: block; color: #91a99a; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.stats-title { display: block; margin-top: 7rpx; font-size: 42rpx; line-height: 1.2; font-weight: 800; }
.stats-description { display: block; margin-top: 7rpx; color: #9aac9f; font-size: 21rpx; }
.stats-filter { margin-top: 26rpx; padding: 18rpx; background: rgba(5, 12, 9, 0.28); border: 1px solid rgba(207, 229, 214, 0.1); border-radius: 16rpx; }
.stats-filter-head { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12rpx; margin-bottom: 14rpx; color: #c6d4ca; font-size: 22rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.section-heading > view:first-child { flex: 1; min-width: 0; }
.stats-mode,.type-switch { display: flex; box-sizing: border-box; padding: 4rpx; gap: 4rpx; border-radius: 10rpx; background: rgba(0, 0, 0, 0.23); }
.stats-mode { width: 100%; }
.stats-mode button,.type-switch button { flex: 1; width: auto; min-width: 0; height: 46rpx; margin: 0; padding: 0 14rpx; box-sizing: border-box; border-radius: 8rpx; background: transparent; color: #9aada1; font-size: 20rpx; line-height: 46rpx; }
.stats-mode button.active { background: #c8f276; color: #172018; font-weight: 700; }
.stats-mode button::after,.type-switch button::after { border: 0; }
.stats-date { width: 100%; min-height: 58rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-radius: 10rpx; background: rgba(235, 247, 238, 0.07); color: #eef4ef; font-size: 22rpx; }
.stats-date text { color: #9bb29f; font-size: 26rpx; }
.stats-range { display: flex; align-items: center; gap: 10rpx; }
.stats-range picker { min-width: 0; flex: 1; }
.range-separator { color: #90a197; font-size: 20rpx; }
.stats-loading { padding: 80rpx 0; text-align: center; color: #a0b0a5; font-size: 23rpx; }
.stats-content { padding-top: 20rpx; }
.cashflow-panel { padding: 26rpx; border: 1px solid rgba(204, 230, 213, 0.13); border-radius: 18rpx; background: linear-gradient(135deg, #23382e, #192822); animation: statsEnter 360ms ease-out both; }
.panel-kicker { display: block; color: #9fb5a5; font-size: 18rpx; font-weight: 700; letter-spacing: 1.5rpx; }
.cashflow-total { display: block; margin-top: 12rpx; color: #f3f8f3; font-size: 48rpx; font-weight: 760; font-variant-numeric: tabular-nums; }
.cashflow-items { display: flex; margin-top: 24rpx; gap: 22rpx; }
.cashflow-items view { flex: 1; display: flex; flex-direction: column; gap: 7rpx; color: #9fb1a4; font-size: 20rpx; }
.income-number { color: #c4eb91; font-size: 25rpx; font-weight: 700; }
.expense-number { color: #f1a39a; font-size: 25rpx; font-weight: 700; }
.ratio-track { height: 10rpx; margin-top: 22rpx; overflow: hidden; border-radius: 99rpx; background: rgba(235, 247, 238, 0.1); }
.ratio-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #d8f18d, #eeaa8d); transition: width 260ms ease; }
.ratio-caption { display: block; margin-top: 9rpx; color: #9aada1; font-size: 18rpx; text-align: right; }
.insight-row { display: flex; gap: 12rpx; margin-top: 12rpx; }
.insight-item { min-width: 0; flex: 1; padding: 17rpx; border: 1px solid rgba(207, 224, 211, 0.1); border-radius: 14rpx; background: rgba(230, 242, 233, 0.045); }
.insight-label { display: block; color: #97a89d; font-size: 19rpx; }
.insight-value { display: block; margin-top: 8rpx; overflow: hidden; color: #e5eee7; font-size: 23rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.chart-section { margin-top: 14rpx; padding: 21rpx; border: 1px solid rgba(207, 224, 211, 0.1); border-radius: 16rpx; background: rgba(230, 242, 233, 0.045); }
.chart-title { display: block; color: #e6efe8; font-size: 25rpx; font-weight: 750; }
.chart-subtitle { display: block; margin-top: 5rpx; color: #8fa097; font-size: 18rpx; }
.type-switch { flex: 0 0 auto; }
.type-switch button { flex: 0 0 auto; min-width: 82rpx; }
.type-switch button.active.expense-active { background: #d89186; color: #241b19; font-weight: 700; }
.type-switch button.active.income-active { background: #c8f276; color: #172018; font-weight: 700; }
.category-chart { margin-top: 20rpx; }
.category-chart-row { position: relative; padding: 10rpx 0 14rpx; }
.category-line { display: flex; justify-content: space-between; gap: 12rpx; color: #dce7de; font-size: 21rpx; }
.category-line text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.category-line text:last-child { flex-shrink: 0; color: #c4d2c7; font-variant-numeric: tabular-nums; }
.category-track { height: 9rpx; margin-top: 10rpx; overflow: hidden; border-radius: 99rpx; background: rgba(235, 247, 238, 0.09); }
.category-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #d89186, #e8aa8e); transition: width 300ms ease; }
.category-fill.income-fill { background: linear-gradient(90deg, #a9d66d, #c8f276); }
.category-share { position: absolute; right: 0; bottom: 1rpx; color: #85968b; font-size: 17rpx; }
.chart-empty { padding: 34rpx 0 20rpx; color: #8fa097; font-size: 21rpx; text-align: center; }
.legend { display: flex; gap: 12rpx; color: #9aaba0; font-size: 17rpx; }
.legend text { display: flex; align-items: center; gap: 5rpx; }
.legend-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.legend-income { background: #c8f276; }
.legend-expense { background: #e39b8d; }
.trend-chart { margin-top: 20rpx; }
.trend-chart-row { display: grid; grid-template-columns: 72rpx minmax(32rpx, 1fr) 78rpx minmax(32rpx, 1fr) 78rpx; align-items: center; gap: 8rpx; min-height: 42rpx; }
.trend-date { color: #9eafa3; font-size: 18rpx; }
.trend-track { height: 9rpx; overflow: hidden; border-radius: 99rpx; background: rgba(235, 247, 238, 0.07); }
.trend-fill { height: 100%; border-radius: inherit; transition: width 280ms ease; }
.trend-income-fill { background: #b8df83; }
.trend-expense-fill { background: #e19b8e; }
.trend-amount { color: #a6b4aa; font-size: 16rpx; text-align: right; font-variant-numeric: tabular-nums; }

@keyframes statsEnter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
